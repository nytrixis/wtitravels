# ─── Site ───────────────────────────────────────────────
PUBLIC_SITE_URL=https://www.your-domain.com

# ─── Contact (replace once final details are available) ──
PUBLIC_PHONE="+91 00000 00000"
PUBLIC_PHONE_ALT=""
PUBLIC_EMAIL="hello@your-domain.com"
PUBLIC_EMAIL_ALT=""
# WhatsApp number in international format, digits only (e.g. 919999999999)
PUBLIC_WHATSAPP=""
PUBLIC_ADDRESS="Office address, City, Country"

# ─── Lead capture ───────────────────────────────────────
# Any JSON-accepting form endpoint. Works out of the box with Web3Forms
# (https://api.web3forms.com/submit + PUBLIC_FORM_ACCESS_KEY) or Formspree
# (https://formspree.io/f/xxxx). If empty, leads fall back to WhatsApp / email.
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=

# ─── Telemetry (all optional; each loads only after consent) ─
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_CLARITY_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
# Optional first-party event sink (receives sendBeacon JSON)
PUBLIC_TELEMETRY_ENDPOINT=

# ─── Search Console / Bing verification ────────────────
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=

# ─── Consent behaviour ─────────────────────────────────
# auto   = opt-in for Europe/UK timezones, notice + opt-out elsewhere (default)
# strict = opt-in everywhere
PUBLIC_CONSENT_MODE=auto

# ─── Social profiles (leave empty to hide the icon) ────
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_TWITTER=
PUBLIC_SOCIAL_TRIPADVISOR=

# ─── Contact person shown on the Contact page ──────────
PUBLIC_CONTACT_PERSON=
PUBLIC_CONTACT_PERSON_PHONE=
