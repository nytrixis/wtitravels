---
import TourGrid from '@/components/tours/TourGrid.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, whatsappLink } from '@/config/site';
import { pick, popularSlugs } from '@/lib/tours';
import BaseLayout from '@/layouts/BaseLayout.astro';

const picks = pick(popularSlugs.slice(0, 3));
---

<BaseLayout title="Thank you — we’re on it" description="Your enquiry has been received." noindex focused minimalHeader>
  <section class="ty">
    <div class="container--narrow ty__card">
      <span class="ty__tick"><Icon name="check" size={36} /></span>
      <h1>Thank you<span data-first-name></span> — we’re on it!</h1>
      <p class="ty__lede">
        Your enquiry is with our trip planners. Expect a tailor-made proposal in your inbox within <strong>{site.claims.proposalHours} hours</strong>.
      </p>
      <p class="ty__ref" data-lead-ref-wrap hidden>Reference: <strong data-lead-ref></strong></p>

      <ol role="list" class="ty__next">
        <li><strong>We read every request</strong><small>A planner reviews your dates, interests and group.</small></li>
        <li><strong>You get a day-by-day plan</strong><small>Hotels, transport, guides and transparent pricing.</small></li>
        <li><strong>Refine it with us</strong><small>Change anything until it feels exactly right.</small></li>
      </ol>

      <div class="ty__actions">
        {site.contact.whatsapp && (
          <a class="btn btn--green btn--lg" data-lead-whatsapp href={whatsappLink('Hi! I just sent an enquiry on your website.')} target="_blank" rel="noopener" data-track-location="thank_you">
            <Icon name="whatsapp" size={20} /> Fast-track on WhatsApp
          </a>
        )}
        <a class="btn btn--ghost btn--lg" href={site.contact.phoneHref} data-track-location="thank_you"><Icon name="phone" size={20} /> {site.contact.phone}</a>
      </div>
    </div>

    <div class="container ty__more">
      <h2>While you wait, explore popular tours</h2>
      <TourGrid tours={picks} list="thank_you" />
      <p class="ty__home"><a href="/" class="link-arrow">Back to home</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .ty {
    padding-block: var(--space-7) var(--space-8);
    display: grid;
    gap: var(--space-8);
  }
  .ty__card {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
  }
  .ty__tick {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--green-soft);
    color: var(--green);
    animation: pop 0.6s var(--ease);
  }
  @keyframes pop {
    from {
      scale: 0.4;
      opacity: 0;
    }
  }
  .ty h1 {
    font-size: var(--step-4);
  }
  .ty__lede {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 44ch;
  }
  .ty__ref {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 0.9rem;
  }
  .ty__ref[hidden] {
    display: none;
  }
  .ty__next {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin: var(--space-3) 0;
    text-align: left;
    width: 100%;
    counter-reset: n;
  }
  .ty__next li {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-4);
    background: var(--white);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-s);
    counter-increment: n;
  }
  .ty__next li::before {
    content: counter(n);
    font-family: var(--font-display);
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--accent);
  }
  .ty__next small {
    color: var(--ink-3);
    line-height: 1.45;
  }
  .ty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
  .ty__more {
    display: grid;
    gap: var(--space-5);
  }
  .ty__more h2 {
    font-size: var(--step-3);
    text-align: center;
  }
  .ty__home {
    text-align: center;
  }
  @media (max-width: 48rem) {
    .ty__next {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initThankYou } from '@/scripts/thank-you';
  initThankYou();
</script>
