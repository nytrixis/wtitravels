---
import { getEntry, render } from 'astro:content';
import LegalLayout from '@/layouts/LegalLayout.astro';

const entry = (await getEntry('legal', 'privacy-policy'))!;
const { Content } = await render(entry);
---

<LegalLayout title={entry.data.title} description={entry.data.description} updated={entry.data.updated} path="/privacy-policy/">
  <Content />
</LegalLayout>
