---
import EnquiryForm from '@/components/forms/EnquiryForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, whatsappLink } from '@/config/site';
import { process } from '@/data/content';
import { heroes } from '@/lib/heroes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
---

<BaseLayout
  title="Plan Your Trip — Free Itinerary in 24 Hours"
  description={`Tell us your dates and interests. ${site.name} will send a tailor-made, day-by-day proposal with transparent pricing within ${site.claims.proposalHours} hours.`}
  image={heroes.tajMahal}
  focused
  minimalHeader
>
  <section class="plan">
    <div class="plan__bg" aria-hidden="true">
      <Image src={heroes.tajMahal} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" style="object-position:50% 60%" />
    </div>
    <div class="container plan__grid">
      <div class="plan__copy">
        <p class="eyebrow">Free · No obligation</p>
        <h1>Let’s plan your trip</h1>
        <p class="plan__lede">
          Two quick steps. A real trip planner reviews every request and replies with a tailor-made proposal in {site.claims.proposalHours} hours.
        </p>
        <ol role="list" class="plan__steps">
          {process.map((s) => <li><span>{s.step}</span><div><strong>{s.title}</strong><small>{s.body}</small></div></li>)}
        </ol>
        <ul role="list" class="plan__proof">
          <li><Icon name="shield" size={18} /> Best price guaranteed — no hidden costs</li>
          <li><Icon name="heart" size={18} /> {site.claims.happyClients} happy travelers</li>
        </ul>
        {site.contact.whatsapp && (
          <p class="plan__alt">
            Prefer to chat? <a href={whatsappLink('Hi! I would like help planning a trip.')} target="_blank" rel="noopener" data-track-location="plan_page">WhatsApp us</a>
            or call <a href={site.contact.phoneHref} data-track-location="plan_page">{site.contact.phone}</a>
          </p>
        )}
      </div>
      <div class="plan__form" id="enquire">
        <EnquiryForm source="plan-your-trip" idPrefix="plan" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .plan {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-7) var(--space-8);
    color: var(--white);
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
  }
  .plan__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .plan__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plan__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(95deg, rgb(7 28 18 / 0.92) 20%, rgb(7 28 18 / 0.7));
  }
  .plan__grid {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: var(--space-8);
    align-items: center;
  }
  .plan__copy {
    display: grid;
    gap: var(--space-5);
  }
  .plan__copy .eyebrow {
    color: var(--orange);
  }
  .plan h1 {
    font-size: var(--step-5);
  }
  .plan__lede {
    font-size: var(--step-1);
    color: rgb(255 255 255 / 0.85);
    max-width: 44ch;
  }
  .plan__steps {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .plan__steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .plan__steps span {
    font-family: var(--font-display);
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-3);
    color: var(--orange);
    line-height: 1;
    min-width: 2.2rem;
  }
  .plan__steps strong {
    display: block;
  }
  .plan__steps small {
    color: rgb(255 255 255 / 0.72);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .plan__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    font-weight: 560;
    font-size: 0.92rem;
  }
  .plan__proof li {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
  .plan__proof :global(svg) {
    color: var(--orange);
  }
  .plan__alt {
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.8);
  }
  .plan__alt a {
    color: var(--orange);
    font-weight: 600;
  }
  .plan__form {
    padding: var(--space-6);
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-l);
  }
  @media (max-width: 62rem) {
    .plan__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .plan__steps {
      display: none;
    }
  }
  @media (max-width: 34rem) {
    .plan__form {
      padding: var(--space-5);
    }
  }
</style>

<script>
  // ?tour=<title or slug> preselects the tour in the form (deep links from ads/emails).
  const wanted = new URLSearchParams(location.search).get('tour')?.toLowerCase();
  const select = document.querySelector<HTMLSelectElement>('#enquire select[name="interest"]');
  if (wanted && select) {
    const match = [...select.options].find(
      (o) => o.value.toLowerCase() === wanted || o.value.toLowerCase().replace(/[^a-z0-9]+/g, '-') === wanted,
    );
    if (match) select.value = match.value;
  }
</script>
