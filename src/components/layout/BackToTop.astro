---
import Icon from '@/components/ui/Icon.astro';
---

<button class="top" type="button" aria-label="Back to top" data-back-to-top hidden>
  <Icon name="arrow-right" size={20} />
</button>

<style>
  .top {
    position: fixed;
    right: 1.25rem;
    bottom: 5.9rem; /* sits above the WhatsApp button */
    z-index: 85;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-s);
    color: var(--ink);
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      translate 0.4s var(--ease-out-expo),
      background 0.2s,
      color 0.2s;
  }
  .top :global(svg) {
    rotate: -90deg;
  }
  .top.is-on {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  .top:hover {
    background: var(--forest);
    color: var(--white);
  }
  @media (max-width: 52rem) {
    .top {
      bottom: calc(var(--bar-h) + 1.5rem + env(safe-area-inset-bottom));
      right: 1rem;
    }
  }
</style>

<script>
  import { track } from '@/scripts/telemetry';

  const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (btn) {
    btn.hidden = false;
    let ticking = false;
    const update = () => {
      ticking = false;
      btn.classList.toggle('is-on', scrollY > 700);
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    btn.addEventListener('click', () => {
      track('back_to_top');
      if (window.__lenis) window.__lenis.scrollTo(0, { duration: 1.1 });
      else scrollTo({ top: 0, behavior: 'smooth' });
    });
    update();
  }
</script>
