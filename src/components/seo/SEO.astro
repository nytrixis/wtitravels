---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';
import { abs } from '@/lib/schema';
import defaultOg from '@/assets/hero/taj-mahal.jpg';

interface Props {
  title: string;
  description?: string;
  /** Path such as /tours/ — defaults to the current URL path. */
  path?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD objects. */
  schema?: Record<string, unknown>[];
  published?: Date;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  image = defaultOg,
  type = 'website',
  noindex = false,
  schema = [],
  published,
} = Astro.props;

// Keep titles inside ~60 characters so search results don't truncate them:
// full brand → short brand → no brand.
const candidates = title.includes(site.shortName)
  ? [title]
  : [`${title} | ${site.name}`, `${title} | ${site.shortName}`, title];
const fullTitle = candidates.find((c) => c.length <= 60) ?? candidates[candidates.length - 1];
const canonical = abs(path);
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', quality: 78 });
const ogUrl = abs(og.src);
const trimmed = description.length > 160 ? `${description.slice(0, 157).trimEnd()}…` : description;
---

<title>{fullTitle}</title>
<meta name="description" content={trimmed} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={trimmed} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{published && <meta property="article:published_time" content={published.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={trimmed} />
<meta name="twitter:image" content={ogUrl} />

{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
