---
interface Props {
  items: readonly { q: string; a: string }[];
  /** Open the first item on load. */
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {items.map((item, i) => (
    <details class="faq__item" open={openFirst && i === 0} data-track-faq={item.q}>
      <summary>
        <span>{item.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
    padding-block: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 540;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    transition: rotate 0.3s var(--ease);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 28%;
    height: 1.5px;
    background: currentColor;
    translate: 0 -50%;
  }
  .faq__icon::after {
    rotate: 90deg;
    transition: opacity 0.2s;
  }
  details[open] .faq__icon {
    rotate: 180deg;
  }
  details[open] .faq__icon::after {
    opacity: 0;
  }
  p {
    padding-bottom: 1.4rem;
    max-width: 62ch;
    color: var(--ink-2);
  }
</style>

<script>
  import { track } from '@/scripts/telemetry';
  document.querySelectorAll<HTMLDetailsElement>('details[data-track-faq]').forEach((el) =>
    el.addEventListener('toggle', () => el.open && track('faq_open', { question: el.dataset.trackFaq })),
  );
</script>
