---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { destinationUrl, destinations } from '@/data/destinations';
import { heroes } from '@/lib/heroes';
import { tours } from '@/lib/tours';

const art = { india: heroes.hawaMahal, nepal: heroes.nepal, bhutan: heroes.bhutan, 'sri-lanka': heroes.sriLanka } as const;
const focus = { india: '50% 40%', nepal: '40% 50%', bhutan: '45% 40%', 'sri-lanka': '50% 35%' } as const;
const count = (id: string) => tours.filter((t) => t.regions.includes(id as never)).length;
---

<div class="dl" data-dest-list data-location="destination_list">
  <ul role="list" class="dl__list">
    {destinations.map((d, i) => (
      <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
        <a
          href={destinationUrl(d.slug)}
          class="row"
          data-dest={d.id}
          data-track="select_destination"
          data-track-destination={d.name}
        >
          <span class="row__no">0{i + 1}</span>
          <span class="row__name">{d.name}</span>
          <span class="row__line">{d.strapline}</span>
          <span class="row__count">{count(d.id)} {count(d.id) === 1 ? 'tour' : 'tours'}</span>
          <span class="row__thumb arch" aria-hidden="true">
            <Image src={art[d.id]} alt="" width={160} height={200} widths={[160, 320]} sizes="5rem" loading="lazy" style={`object-position:${focus[d.id]}`} />
          </span>
          <span class="row__go" aria-hidden="true"><Icon name="arrow-up-right" size={22} /></span>
        </a>
      </li>
    ))}
  </ul>

  <!-- Desktop: a photo follows the pointer and swaps per row -->
  <div class="dl__preview" aria-hidden="true">
    {destinations.map((d) => (
      <span class="dl__shot" data-shot={d.id}>
        <Image src={art[d.id]} alt="" width={440} height={560} widths={[440, 880]} sizes="18rem" loading="lazy" style={`object-position:${focus[d.id]}`} />
      </span>
    ))}
  </div>
</div>

<style>
  .dl {
    position: relative;
  }
  .dl__list {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .dl__list li {
    border-bottom: 1px solid var(--line-strong);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1.2fr) minmax(0, 1fr) 6.5rem 3.4rem;
    align-items: center;
    gap: var(--space-5);
    padding-block: clamp(1.2rem, 2.4vw, 2rem);
    text-decoration: none;
    transition:
      padding 0.5s var(--ease-out-expo),
      color 0.3s;
  }
  .row__no {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--accent);
  }
  .row__name {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 96;
    font-weight: 700;
    font-size: clamp(2.4rem, 1.2rem + 5vw, 5.6rem);
    letter-spacing: -0.045em;
    line-height: 1;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .row__line {
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 24rem;
  }
  .row__count {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .row__thumb {
    display: none;
    width: 4rem;
    height: 5rem;
  }
  .row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__go {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    transition: all 0.4s var(--ease-out-expo);
  }
  @media (hover: hover) {
    .dl__list:hover .row:not(:hover) {
      color: var(--ink-3);
    }
    .row:hover .row__name {
      transform: translateX(1.2rem);
    }
    .row:hover .row__go {
      background: var(--orange);
      border-color: var(--orange);
      color: var(--ink);
      rotate: 45deg;
    }
  }

  /* Pointer-following photo */
  .dl__preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 18rem;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    border-radius: 999px 999px var(--radius-m) var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-l);
    transition:
      opacity 0.3s ease,
      scale 0.5s var(--ease-out-expo);
    will-change: transform;
  }
  .dl__preview.is-on {
    opacity: 1;
    scale: 1;
  }
  .dl__shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .dl__shot.is-on {
    opacity: 1;
  }
  .dl__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 62rem) {
    .row {
      grid-template-columns: 2.4rem minmax(0, 1fr) auto 3rem;
      grid-template-areas: 'no name thumb go' 'no line thumb go';
      gap: 0.3rem var(--space-4);
    }
    .row__no {
      grid-area: no;
    }
    .row__name {
      grid-area: name;
    }
    .row__line {
      grid-area: line;
    }
    .row__count {
      display: none;
    }
    .row__thumb {
      display: block;
      grid-area: thumb;
    }
    .row__go {
      grid-area: go;
      width: 3rem;
      height: 3rem;
    }
    .dl__preview {
      display: none;
    }
  }
  @media (max-width: 34rem) {
    .row__line {
      display: none;
    }
    .row {
      grid-template-areas: 'no name thumb go';
    }
  }
</style>

<script>
  import { finePointer, reducedMotion } from '@/scripts/motion/env';

  const root = document.querySelector<HTMLElement>('[data-dest-list]');
  const preview = root?.querySelector<HTMLElement>('.dl__preview');
  if (root && preview && finePointer() && !reducedMotion()) {
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.16;
      y += (ty - y) * 0.16;
      preview.style.transform = `translate3d(${x + 28}px, ${y - preview.offsetHeight / 2}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.4 ? requestAnimationFrame(loop) : 0;
    };
    const show = (id: string | null) => {
      preview.classList.toggle('is-on', Boolean(id));
      preview.querySelectorAll<HTMLElement>('.dl__shot').forEach((s) => s.classList.toggle('is-on', s.dataset.shot === id));
    };
    root.addEventListener('pointermove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (!preview.classList.contains('is-on')) {
        x = tx;
        y = ty;
      }
      if (!raf) raf = requestAnimationFrame(loop);
      show((e.target as HTMLElement).closest<HTMLElement>('[data-dest]')?.dataset.dest ?? null);
    });
    root.addEventListener('pointerleave', () => show(null));
  }
</script>
