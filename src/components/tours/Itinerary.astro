---
import type { ItineraryStep } from '@/lib/tours';

interface Props {
  steps: ItineraryStep[];
  tour: string;
}
const { steps, tour } = Astro.props;
---

<div class="itin" data-itinerary data-tour={tour}>
  <div class="itin__bar">
    <p>{steps.length} {steps.length === 1 ? 'stop' : 'days'} · tap to expand</p>
    <button type="button" class="itin__toggle" data-toggle-all aria-pressed="false">Expand all</button>
  </div>
  <ol role="list" class="itin__list">
    {steps.map((step, i) => (
      <li class="itin__step">
        <details open={i === 0} data-day={step.label}>
          <summary>
            <span class="itin__label">{step.label}</span>
            <span class="itin__title">{step.title}</span>
            <span class="itin__chev" aria-hidden="true"></span>
          </summary>
          <div class="itin__body">
            {step.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </details>
      </li>
    ))}
  </ol>
</div>

<style>
  .itin__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .itin__toggle {
    border: 0;
    background: none;
    font-weight: 650;
    color: var(--accent-deep);
    text-decoration: underline;
    padding: 0.5rem;
  }
  .itin__list {
    position: relative;
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: 1.6rem;
  }
  /* Dotted route line connecting the days */
  .itin__list::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 1.6rem;
    bottom: 1.6rem;
    border-left: 2px dashed var(--line-strong);
  }
  .itin__step {
    position: relative;
  }
  .itin__step::before {
    content: '';
    position: absolute;
    left: -1.6rem;
    top: 1.45rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--accent);
  }
  details {
    background: var(--white);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-s);
    overflow: hidden;
  }
  summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: 1.1rem 1.3rem;
    min-height: 4rem;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .itin__label {
    font-family: var(--font-display);
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.35rem;
    font-weight: 450;
    color: var(--accent);
    min-width: 4.6rem;
    font-variation-settings: 'opsz' 72;
  }
  .itin__title {
    font-weight: 650;
    line-height: 1.35;
  }
  .itin__chev {
    width: 0.65rem;
    height: 0.65rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    margin-right: 0.3rem;
    transition: rotate 0.3s var(--ease);
  }
  details[open] .itin__chev {
    rotate: 225deg;
  }
  .itin__body {
    display: grid;
    gap: var(--space-3);
    padding: 0 1.3rem 1.4rem calc(1.3rem + 4.6rem + var(--space-4));
    color: var(--ink-2);
    line-height: 1.7;
  }
  @media (max-width: 40rem) {
    summary {
      grid-template-columns: 1fr auto;
      gap: 0.2rem var(--space-3);
    }
    .itin__label {
      grid-column: 1;
      min-width: 0;
      font-size: 1.1rem;
    }
    .itin__title {
      grid-column: 1;
    }
    .itin__chev {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .itin__body {
      padding: 0 1.3rem 1.3rem;
    }
  }
</style>

<script>
  import { track } from '@/scripts/telemetry';

  document.querySelectorAll<HTMLElement>('[data-itinerary]').forEach((root) => {
    const all = [...root.querySelectorAll<HTMLDetailsElement>('details')];
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle-all]')!;
    let expanded = false;
    btn.addEventListener('click', () => {
      expanded = !expanded;
      all.forEach((d) => (d.open = expanded));
      btn.textContent = expanded ? 'Collapse all' : 'Expand all';
      btn.setAttribute('aria-pressed', String(expanded));
      track('itinerary_toggle_all', { tour: root.dataset.tour, expanded });
    });
    all.forEach((d) =>
      d.addEventListener('toggle', () => d.open && track('itinerary_expand', { tour: root.dataset.tour, day: d.dataset.day })),
    );
  });
</script>
