---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs: { name: string; href?: string }[];
  image?: ImageMetadata;
  /** CSS object-position for the background photo. */
  focus?: string;
}
const { eyebrow, title, lede, crumbs, image, focus = 'center' } = Astro.props;
---

<section class:list={['phero', image && 'phero--photo']}>
  {image && (
    <div class="phero__bg" aria-hidden="true">
      <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${focus}`} />
    </div>
  )}
  <div class="container phero__inner">
    <Breadcrumbs items={crumbs} tone={image ? 'light' : 'dark'} />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    padding-block: calc(var(--space-7) + 0.5rem) var(--space-7);
    background: var(--paper-2);
  }
  .phero__inner {
    display: grid;
    gap: var(--space-4);
    max-width: var(--container);
  }
  .phero h1 {
    font-size: var(--step-5);
    max-width: 18ch;
  }
  .phero--photo {
    color: var(--white);
    background: var(--ink);
    padding-block: calc(var(--header-h) + var(--space-7)) var(--space-8);
    min-height: min(30rem, 62svh);
    display: grid;
    align-items: end;
  }
  .phero--photo .lede {
    color: rgb(255 255 255 / 0.88);
  }
  .phero--photo .eyebrow {
    color: var(--white);
  }
  .phero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .phero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 28 18 / 0.6) 0%, rgb(7 28 18 / 0.38) 38%, rgb(7 28 18 / 0.82) 100%);
  }
  .phero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
