---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { breadcrumbSchema } from '@/lib/schema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: Date;
  path: string;
}
const { title, description, updated, path } = Astro.props;
---

<BaseLayout {title} {description} schema={[breadcrumbSchema([{ name: 'Home', href: '/' }, { name: title, href: path }])]}>
  <section class="legal">
    <div class="container--narrow">
      <Breadcrumbs items={[{ name: title }]} />
      <h1>{title}</h1>
      <p class="legal__date">Last updated {updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-6) var(--space-8);
  }
  .legal :global(.crumbs) {
    margin-bottom: var(--space-5);
  }
  h1 {
    font-size: var(--step-4);
    margin-bottom: var(--space-2);
  }
  .legal__date {
    color: var(--ink-3);
    font-size: 0.9rem;
    margin-bottom: var(--space-6);
  }
  .prose {
    max-width: none;
  }
</style>
